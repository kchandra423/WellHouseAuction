# Postgres connection string (Neon on Vercel, or local Postgres for development)
DATABASE_URL=postgres://user:password@host/dbname

# Run `npx auth secret` to generate this
AUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that can see the Admin page
ADMIN_EMAILS=you@stanford.edu

# Optional: protects the backup cron endpoint (Vercel sends it automatically)
CRON_SECRET=
